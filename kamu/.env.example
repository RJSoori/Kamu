# Copy to .env.local and fill in real values. .env.local is gitignored --
# never commit real keys. Shape is validated at boot by src/lib/env.ts.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox account -> Tokens. Optional -- the app boots without it, but the
# restaurant detail page's map falls back to a plain text notice until it's
# set (see src/components/site/RestaurantMap.tsx).
NEXT_PUBLIC_MAPBOX_TOKEN=
