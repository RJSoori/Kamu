# Copy to .env.local and fill in real values. .env.local is gitignored --
# never commit real keys. Shape is validated at boot by src/lib/env.ts
# (public) and src/lib/env.server.ts (server-only).

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings -> API -> service_role key
# Server-only (no NEXT_PUBLIC_ prefix, guarded by env.server.ts + the
# `server-only` import). Bypasses RLS -- only src/lib/supabase/admin.ts
# should read this. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox account -> Tokens. Not wired into any code yet -- needed starting
# Phase 2 (map view on the restaurant list/detail pages).
NEXT_PUBLIC_MAPBOX_TOKEN=
