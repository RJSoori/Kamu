# Copy to .env.local and fill in real values. .env.local is gitignored --
# never commit real keys. Shape is validated at boot by src/lib/env.ts.
#
# This app shares ONE Supabase project with the customer-facing `kamu` app
# (same restaurants/menu_items tables) -- use the identical values from
# kamu/.env.local here, don't create a second project.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
